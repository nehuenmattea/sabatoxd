# Base de datos local (se genera sola al ejecutar la app)
estanteria.db
estanteria.db-journal

# Python
__pycache__/
*.pyc
*.pyo
.Python
venv/
env/
.venv/

# Imágenes subidas por el usuario (contenido personal, no código)
static/covers/*
!static/covers/.gitkeep
static/list_backgrounds/*
!static/list_backgrounds/.gitkeep
static/profile/*
!static/profile/.gitkeep

# Copia de seguridad automática que se genera al restaurar una base de datos
estanteria.antes-de-restaurar.db

# Archivos del sistema operativo
.DS_Store
Thumbs.db

# Editores
.vscode/
.idea/

# Carpetas que genera PyInstaller al compilar el ejecutable
build/
dist/
